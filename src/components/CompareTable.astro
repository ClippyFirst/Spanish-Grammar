---
// CompareTable — side-by-side comparison (used on comparison pages).
interface Props {
  caption?: string;
  headers: string[];
  rows: { label: string; cells: string[] }[];
}
const { caption, headers, rows } = Astro.props;

for (const [index, row] of rows.entries()) {
  if (row.cells.length !== headers.length - 1) {
    throw new Error(`CompareTable row ${index + 1} has ${row.cells.length} data cells, but headers define ${headers.length - 1} data columns.`);
  }
}
---
<div class="table-scroll">
  <table class="gram">
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>{headers.map((h) => <th scope="col">{h}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.label}</th>
          {r.cells.map((c) => <td>{c}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>