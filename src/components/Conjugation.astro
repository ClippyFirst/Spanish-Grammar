---
// Conjugation — a grammatical table for verb forms / agreements.
// Rows: [{label, cells: string[]}]. First cell of each row is the row header.
interface Row { label: string; cells: string[]; }
interface Props {
  caption?: string;
  headers: string[];
  rows: Row[];
}
const { caption, headers, rows } = Astro.props;
---
<div class="table-scroll">
  <table class="gram">
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr><th scope="col"></th>{headers.map((h) => <th scope="col">{h}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.label}</th>
          {r.cells.map((c) => <td>{c}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>