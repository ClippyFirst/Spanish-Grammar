---
// Mistake — a compact editorial correction pair.
// The visual language follows the Gramaticarrona redesign:
// incorrect form → correct form, with the explanation underneath.
interface Props {
  bad: string;
  good: string;
  why: string;
}
const { bad, good, why } = Astro.props;
---
<div class="mistake">
  <div class="mistake-row">
    <span class="mistake-bad">{bad}</span>
    <span class="mistake-arrow" aria-hidden="true">→</span>
    <span class="mistake-good">{good}</span>
  </div>
  <p class="mistake-why">{why}</p>
</div>
