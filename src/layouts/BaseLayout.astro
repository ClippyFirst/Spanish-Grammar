---
// BaseLayout — the HTML shell shared by every page.
// Handles SEO meta, canonical, Open Graph, hreflang, favicon and CSS.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/content';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/grammar.css';
import '../styles/prose.css';
import '../styles/gramaticarrona.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute canonical path, e.g. "/es/verbs/ser-estar/" */
  canonical?: string;
  /** Alternate language URLs for hreflang (path -> lang). */
  alternates?: { path: string; lang: string }[];
  ogImage?: string;
}

const {
  title,
  description = 'Іспанська граматика для носіїв української — правила, формули, приклади, типові помилки та регіональні варіанти.',
  canonical = '/',
  alternates = [],
  ogImage,
} = Astro.props;

const site = Astro.site ?? new URL('https://example.org');

/**
 * Resolve a page asset against the deployed site while respecting Astro's
 * configured project base (for example /Spanish-Grammar on GitHub Pages).
 *
 * Astro.site is intentionally the site origin; withBase() owns the project
 * sub-path. Using new URL('/es/...', site) directly would silently discard
 * that sub-path and produce incorrect canonical/OG/hreflang URLs.
 */
function absoluteSiteUrl(pathOrUrl: string): URL {
  if (/^https?:\\/\\//i.test(pathOrUrl)) return new URL(pathOrUrl);
  return new URL(withBase(pathOrUrl), site);
}

const canonicalUrl = absoluteSiteUrl(canonical);
const ogImageUrl = ogImage ? absoluteSiteUrl(ogImage) : null;
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gramaticarrona" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content="uk_UA" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl.href} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={absoluteSiteUrl(a.path).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={canonicalUrl.href} />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="theme-color" content="#a93625" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700;6..72,800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href={withBase('/pagefind/pagefind-ui.css')} media="print" onload="this.media='all'" />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до вмісту</a>
    <Header pathname={canonical} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>