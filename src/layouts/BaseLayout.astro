---
// BaseLayout — the HTML shell shared by every page.
// Handles SEO meta, canonical, Open Graph, hreflang, favicon and CSS.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/grammar.css';
import '../styles/prose.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute canonical path, e.g. "/es/verbs/ser-estar/" */
  canonical?: string;
  /** Alternate language URLs for hreflang (path -> lang). */
  alternates?: { path: string; lang: string }[];
  ogImage?: string;
}

const {
  title,
  description = 'Довідник з іспанської граматики для україномовних — правила, формули, приклади, типові помилки та регіональні варіанти.',
  canonical = '/',
  alternates = [],
  ogImage,
} = Astro.props;

const site = Astro.site ?? new URL('https://example.org');
const canonicalUrl = new URL(canonical, site);
const ogImageUrl = ogImage ? new URL(ogImage, site) : null;
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GrammarWay ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content="uk_UA" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl.href} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={new URL(a.path, site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={canonicalUrl.href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#a43d2e" />

    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" media="print" onload="this.media='all'" />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до вмісту</a>
    <Header pathname={canonical} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>