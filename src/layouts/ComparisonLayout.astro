---
// ComparisonLayout — consistent structure for comparison pages.
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/content';

interface Props {
  title: string;
  titleEn?: string;
  description: string;
  canonical?: string;
}
const {
  title,
  titleEn,
  description,
  canonical = '/comparisons/',
} = Astro.props;
---
<BaseLayout
  title={`${title} — порівняння · GrammarWay ES`}
  description={description}
  canonical={canonical}
>
  <div class="container container-narrow">
    <nav class="breadcrumbs" aria-label="Хлібні крихти">
      <ol>
        <li><a href={withBase('/')}>Головна</a></li>
        <li><a href={withBase('/comparisons/')}>Порівняння</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    <header class="page-head">
      <h1>{title}</h1>
      {titleEn && <div class="title-en">{titleEn}</div>}
      <p class="synopsis">{description}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
    <nav class="related" aria-labelledby="comp-related">
      <h2 id="comp-related">Інші порівняння</h2>
      <ul>
        <li><a class="related-link" href={withBase('/comparisons/ser-estar/')} aria-label="Ser / Estar — Бути"><span class="r-es">Ser / Estar</span><span class="r-uk">Бути</span></a></li>
        <li><a class="related-link" href={withBase('/comparisons/por-para/')} aria-label="Por / Para — Прийменники"><span class="r-es">Por / Para</span><span class="r-uk">Прийменники</span></a></li>
        <li><a class="related-link" href={withBase('/comparisons/past-tenses/')} aria-label="Pasados — Минулі часи"><span class="r-es">Pasados</span><span class="r-uk">Минулі часи</span></a></li>
        <li><a class="related-link" href={withBase('/comparisons/indicative-subjunctive/')} aria-label="Indicativo / Subjuntivo — Способи"><span class="r-es">Indicativo / Subjuntivo</span><span class="r-uk">Способи</span></a></li>
        <li><a class="related-link" href={withBase('/comparisons/articles/')} aria-label="Artículos — Артиклі"><span class="r-es">Artículos</span><span class="r-uk">Артиклі</span></a></li>
      </ul>
    </nav>
  </div>
</BaseLayout>