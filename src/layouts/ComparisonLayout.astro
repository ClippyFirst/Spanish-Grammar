---
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/content';
import { comparisonUrl, type ComparisonEntry } from '../utils/comparisons';

interface Props {
  entry: ComparisonEntry;
  others: ComparisonEntry[];
}

const { entry, others } = Astro.props;
const { title, titleEn, description } = entry.data;
---
<BaseLayout
  title={`${title} — порівняння · Gramaticarrona`}
  description={description}
  canonical={comparisonUrl(entry.id)}
>
  <div class="container container-narrow">
    <nav class="breadcrumbs" aria-label="Хлібні крихти">
      <ol>
        <li><a href={withBase('/')}>Головна</a></li>
        <li><a href={withBase('/comparisons/')}>Порівняння</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    <header class="page-head">
      <h1>{title}</h1>
      {titleEn && <div class="title-en">{titleEn}</div>}
      <p class="synopsis">{description}</p>
    </header>
    <div class="prose comparison-prose">
      <slot />
    </div>
    {others.length > 0 && (
      <nav class="related" aria-labelledby="comp-related">
        <h2 id="comp-related">Інші порівняння</h2>
        <ul>
          {others.map((item) => (
            <li>
              <a class="related-link" href={comparisonUrl(item.id)} aria-label={item.data.title}>
                <span class="r-es">{item.data.title}</span>
                <span class="r-uk">{item.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</BaseLayout>
