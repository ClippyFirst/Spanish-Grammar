---
import BaseLayout from './BaseLayout.astro';
import { getCategory } from '../data/categories';
import { entryUrl, categoryUrl, parseId, categoryLabel, withBase } from '../utils/content';
import type { GrammarEntry } from '../utils/content';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
  entry: GrammarEntry;
  headings: Heading[];
  related: GrammarEntry[];
}

const { entry, headings, related } = Astro.props;
const { category } = parseId(entry.id);
const cat = getCategory(category);
const canonical = entryUrl(entry);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

function regionLabel(r: string): string {
  const map: Record<string, string> = {
    spain: 'Іспанія',
    'latin-america': 'Латинська Америка',
    rioplatense: 'Ріо-де-ла-Плата',
    mexico: 'Мексика',
    caribbean: 'Кариби',
  };
  return map[r] ?? r;
}
---
<BaseLayout
  title={`${entry.data.title_uk} — ${entry.data.title_es} · Gramaticarrona`}
  description={entry.data.short_description}
  canonical={canonical}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлібні крихти">
      <ol>
        <li><a href={withBase('/')}>Головна</a></li>
        <li><a href={withBase('/es/')}>Граматика</a></li>
        <li><a href={categoryUrl(category)}>{cat?.titleUk ?? categoryLabel(category)}</a></li>
        <li aria-current="page">{entry.data.title_uk}</li>
      </ol>
    </nav>

    <div class="layout-doc grammar-doc">
      {toc.length > 0 && (
        <details class="toc-mobile">
          <summary>Зміст сторінки</summary>
          <nav aria-label="Зміст сторінки">
            <ul>
              {toc.map((h) => (
                <li><a href={`#${h.slug}`} data-depth={h.depth}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        </details>
      )}

      <article>
        <header class="page-head">
          <div class="article-kicker">
            <span class="topic-code">{String(cat?.order ?? 0).padStart(2, '0')}.{String(entry.data.order).padStart(2, '0')}</span>
            {entry.data.cefr && <span class="level-badge">{entry.data.cefr.toUpperCase()}</span>}
            {entry.data.popular && <span class="popular-mark">● популярне</span>}
          </div>
          <h1>{entry.data.title_uk}</h1>
          <div class="title-es">{entry.data.title_es}</div>
          <div class="title-en">{entry.data.title_en}</div>
          <p class="synopsis">{entry.data.short_description}</p>
          <div class="meta-line">
            {entry.data.region !== 'general' && <span class="chip">{regionLabel(entry.data.region)}</span>}
            {entry.data.updated && <span class="chip">Оновлено: {entry.data.updated}</span>}
            {entry.data.review_status !== 'draft' && (
              <span class="chip">Статус: {entry.data.review_status === 'verified' ? 'перевірено' : 'переглянуто'}</span>
            )}
          </div>
        </header>

        <div class="article-rule" aria-hidden="true"></div>

        <div class="prose">
          <slot />
        </div>

        {related.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <h2 id="related-heading">Пов'язані теми</h2>
            <ul>
              {related.map((r) => (
                <li>
                  <a class="related-link" href={entryUrl(r)} aria-label={relationLabel(r)}>
                    <span class="r-es" aria-hidden="true">{r.data.title_es}</span>
                    <span class="r-uk" aria-hidden="true">{r.data.title_uk}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>

      {toc.length > 0 && (
        <aside class="toc" aria-label="Зміст сторінки">
          <h2>Зміст</h2>
          <nav>
            <ul>
              {toc.map((h) => (
                <li><a href={`#${h.slug}`} data-depth={h.depth}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
