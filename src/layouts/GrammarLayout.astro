---
import BaseLayout from './BaseLayout.astro';
import { getCategory } from '../data/categories';
import { entryUrl, categoryUrl, parseId, categoryLabel, withBase } from '../utils/content';
import type { GrammarEntry } from '../utils/content';

interface Props {
  entry: GrammarEntry;
  related: GrammarEntry[];
  prerequisites?: GrammarEntry[];
  contrasts?: GrammarEntry[];
  extensions?: GrammarEntry[];
  exceptions?: GrammarEntry[];
  canonicalTopic?: GrammarEntry;
  topicNumber: number;
}

const {
  entry,
  related,
  prerequisites = [],
  contrasts = [],
  extensions = [],
  exceptions = [],
  canonicalTopic,
  topicNumber,
} = Astro.props;
const { category } = parseId(entry.id);
const cat = getCategory(category);
const canonical = entryUrl(entry);
const typedTargets = new Set(
  [...prerequisites, ...contrasts, ...extensions, ...exceptions, ...(canonicalTopic ? [canonicalTopic] : [])]
    .map((target) => target.id),
);
const relatedOnly = related.filter((target) => !typedTargets.has(target.id));

---
<BaseLayout
  title={`${entry.data.title_uk} — ${entry.data.title_es} · Gramaticarrona`}
  description={entry.data.short_description}
  canonical={canonical}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлібні крихти">
      <ol>
        <li><a href={withBase('/')}>Головна</a></li>
        <li><a href={withBase('/es/')}>Граматика</a></li>
        <li><a href={categoryUrl(category)}>{cat?.titleUk ?? categoryLabel(category)}</a></li>
        <li aria-current="page">{entry.data.title_uk}</li>
      </ol>
    </nav>

    <div class="grammar-doc">
      <article>
        <header class="page-head">
          <div class="article-kicker">
            <span class="topic-code">{String(cat?.order ?? 0).padStart(2, '0')}.{String(topicNumber).padStart(2, '0')}</span>
            {entry.data.cefr && <span class="level-badge">{entry.data.cefr.toUpperCase()}</span>}
            {entry.data.popular && <span class="popular-mark">● популярне</span>}
          </div>
          <h1>{entry.data.title_uk}</h1>
          <div class="title-es">{entry.data.title_es}</div>
          <p class="synopsis">{entry.data.short_description}</p>
        </header>

        <div class="article-rule" aria-hidden="true"></div>

        <div class="prose">
          <slot />
        </div>

        {(canonicalTopic || prerequisites.length || contrasts.length || extensions.length || exceptions.length) && (
          <section class="related semantic-navigation" aria-labelledby="semantic-navigation-heading">
            <h2 id="semantic-navigation-heading">Навігація за змістом</h2>
            {canonicalTopic && (
              <div class="semantic-group">
                <h3>Основне пояснення</h3>
                <div class="related-links">
                  <a class="related-link" href={entryUrl(canonicalTopic)} aria-label={`${canonicalTopic.data.title_es} — ${canonicalTopic.data.title_uk}`}>
                    <span class="r-es" aria-hidden="true">{canonicalTopic.data.title_es}</span>
                    <span class="r-uk" aria-hidden="true">{canonicalTopic.data.title_uk}</span>
                  </a>
                </div>
              </div>
            )}
            {prerequisites.length > 0 && (
              <div class="semantic-group">
                <h3>Передумови</h3>
                <div class="related-links">
                  {prerequisites.map((r) => (
                    <a class="related-link" href={entryUrl(r)} aria-label={`${r.data.title_es} — ${r.data.title_uk}`}>
                      <span class="r-es" aria-hidden="true">{r.data.title_es}</span>
                      <span class="r-uk" aria-hidden="true">{r.data.title_uk}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
            {contrasts.length > 0 && (
              <div class="semantic-group">
                <h3>Порівняти з</h3>
                <div class="related-links">
                  {contrasts.map((r) => (
                    <a class="related-link" href={entryUrl(r)} aria-label={`${r.data.title_es} — ${r.data.title_uk}`}>
                      <span class="r-es" aria-hidden="true">{r.data.title_es}</span>
                      <span class="r-uk" aria-hidden="true">{r.data.title_uk}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
            {extensions.length > 0 && (
              <div class="semantic-group">
                <h3>Далі за темою</h3>
                <div class="related-links">
                  {extensions.map((r) => (
                    <a class="related-link" href={entryUrl(r)} aria-label={`${r.data.title_es} — ${r.data.title_uk}`}>
                      <span class="r-es" aria-hidden="true">{r.data.title_es}</span>
                      <span class="r-uk" aria-hidden="true">{r.data.title_uk}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
            {exceptions.length > 0 && (
              <div class="semantic-group">
                <h3>Обмеження та винятки</h3>
                <div class="related-links">
                  {exceptions.map((r) => (
                    <a class="related-link" href={entryUrl(r)} aria-label={`${r.data.title_es} — ${r.data.title_uk}`}>
                      <span class="r-es" aria-hidden="true">{r.data.title_es}</span>
                      <span class="r-uk" aria-hidden="true">{r.data.title_uk}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </section>
        )}
        {relatedOnly.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <h2 id="related-heading">Пов'язані теми</h2>
            <div class="related-links">
              {relatedOnly.map((r) => (
                <a class="related-link" href={entryUrl(r)} aria-label={`${r.data.title_es} — ${r.data.title_uk}`}>
                  <span class="r-es" aria-hidden="true">{r.data.title_es}</span>
                  <span class="r-uk" aria-hidden="true">{r.data.title_uk}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    </div>
  </div>
</BaseLayout>
