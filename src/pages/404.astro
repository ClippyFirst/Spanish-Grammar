---
// 404 page.
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/content';
---
<BaseLayout title="Сторінку не знайдено · Gramaticarrona" canonical="/404/">
  <div class="container page-404">
    <h1>404 — сторінку не знайдено</h1>
    <p class="lead">
      Такої сторінки немає. Спробуйте пошук або поверніться до розділів граматики.
    </p>
    <p class="page-404-actions">
      <a class="card-topic" href={withBase('/es/')}>До розділів граматики</a>
      <a class="card-topic" href={withBase('/search/')}>Пошук</a>
    </p>
  </div>
</BaseLayout>