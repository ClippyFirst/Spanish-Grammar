---
// 404 page.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Сторінку не знайдено · GrammarWay ES" canonical="/404/">
  <div class="container" style="text-align:center;padding-top:var(--space-8)">
    <h1>404 — сторінку не знайдено</h1>
    <p class="lead" style="margin:0 auto;max-width:46ch">
      Такої сторінки немає. Спробуйте пошук або поверніться до розділів граматики.
    </p>
    <p style="margin-top:var(--space-5)">
      <a class="card-topic" href="/es/" style="display:inline-block">До розділів граматики</a>
      <a class="card-topic" href="/search/" style="display:inline-block;margin-left:var(--space-3)">Пошук</a>
    </p>
  </div>
</BaseLayout>