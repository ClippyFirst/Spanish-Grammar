---
// Comparisons index.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/content';
import { comparisonUrl, sortComparisons } from '../../utils/comparisons';

const comparisons = sortComparisons(await getCollection('comparisons'));

---
<BaseLayout
  title="Порівняння — іспанська граматика · GrammarWay ES"
  description="Порівняння іспанських конструкцій, які україномовні найчастіше плутають: ser/estar, por/para, минулі часи, індикатив/субхунктив, артиклі."
  canonical="/comparisons/"
>
  <div class="container container-narrow">
    <nav class="breadcrumbs" aria-label="Хлібні крихти">
      <ol>
        <li><a href={withBase('/')}>Головна</a></li>
        <li aria-current="page">Порівняння</li>
      </ol>
    </nav>
    <header class="page-head">
      <h1>Порівняння</h1>
      <p class="synopsis">
        Конструкції, де україномовні найчастіше помиляються, — розібрано дослівно, поруч,
        з типовими помилками і мінімальними парами.
      </p>
    </header>
    <ul class="topic-list comparison-index-grid">
      {comparisons.map((c) => (
        <li>
          <a class="card-topic" href={comparisonUrl(c.id)}>
            <span class="t-es">{c.data.title}</span>
            <span class="t-uk">{c.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>