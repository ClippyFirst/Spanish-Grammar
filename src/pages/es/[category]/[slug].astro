---
// Dynamic route for every grammar page: /es/<category>/<slug>/
import { getCollection, render } from 'astro:content';
import GrammarLayout from '../../../layouts/GrammarLayout.astro';
import { mdxComponents } from '../../../components/mdx';
import { resolveRelated, resolveReferences, parseId } from '../../../utils/content';

export async function getStaticPaths() {
  const entries = await getCollection('es');
  return entries.map((entry) => {
    const { category, slug } = parseId(entry.id);
    return {
      params: { category, slug },
      props: { entry, all: entries },
    };
  });
}

interface Props {
  entry: import('astro:content').CollectionEntry<'es'>;
  all: import('astro:content').CollectionEntry<'es'>[];
}

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const related = resolveRelated(entry, all);
const prerequisites = resolveReferences(entry.data.prerequisites, entry, all);
const contrasts = resolveReferences(entry.data.contrasts, entry, all);
const extensions = resolveReferences(entry.data.extensions, entry, all);
const exceptions = resolveReferences(entry.data.exceptions, entry, all);
const canonicalTopic = entry.data.canonical_topic ? resolveReferences([entry.data.canonical_topic], entry, all)[0] : undefined;
---
<GrammarLayout
  entry={entry}
  headings={headings}
  related={related}
  prerequisites={prerequisites}
  contrasts={contrasts}
  extensions={extensions}
  exceptions={exceptions}
  canonicalTopic={canonicalTopic}
>
  <Content components={mdxComponents} />
</GrammarLayout>