---
// Dynamic route for every grammar page: /es/<category>/<slug>/
import { getCollection, render } from 'astro:content';
import GrammarLayout from '../../../layouts/GrammarLayout.astro';
import { mdxComponents } from '../../../components/mdx';
import { resolveRelated, resolveReferences, parseId } from '../../../utils/content';

export async function getStaticPaths() {
  const entries = await getCollection('es');
  return entries.map((entry) => {
    const { category, slug } = parseId(entry.id);
    return {
      params: { category, slug },
      props: { entry, all: entries },
    };
  });
}

interface Props {
  entry: import('astro:content').CollectionEntry<'es'>;
  all: import('astro:content').CollectionEntry<'es'>[];
}

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const related = resolveRelated(entry, all);\nconst prerequisites = resolveReferences(entry.data.prerequisites, entry, all);\nconst contrasts = resolveReferences(entry.data.contrasts, entry, all);\nconst extensions = resolveReferences(entry.data.extensions, entry, all);\nconst exceptions = resolveReferences(entry.data.exceptions, entry, all);
---
<GrammarLayout\n  entry={entry}\n  headings={headings}\n  related={related}\n  prerequisites={prerequisites}\n  contrasts={contrasts}\n  extensions={extensions}\n  exceptions={exceptions}\n>
  <Content components={mdxComponents} />
</GrammarLayout>