---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCategory } from '../../../data/categories';
import { entryUrl, parseId, withBase } from '../../../utils/content';

export async function getStaticPaths() {
  const entries = await getCollection('es');
  const categories = [...new Set(entries.map((e) => parseId(e.id).category))];
  return categories.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const cat = getCategory(category!);
const entries = (await getCollection('es'))
  .filter((e) => parseId(e.id).category === category)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title={`${cat?.titleUk ?? category} — іспанська граматика · Gramaticarrona ES`}
  description={cat?.description}
  canonical={`/es/${category}/`}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлібні крихти">
      <ol>
        <li><a href={withBase('/')}>Головна</a></li>
        <li><a href={withBase('/es/')}>Категорії</a></li>
        <li aria-current="page">{cat?.titleUk ?? category}</li>
      </ol>
    </nav>

    <header class="category-hero page-head">
      <div class="category-number">{String(cat?.order ?? 0).padStart(2, '0')}</div>
      <div class="title-es">{cat?.titleEs}</div>
      <h1>{cat?.titleUk ?? category}</h1>
      <p class="synopsis">{cat?.description}</p>
    </header>

    <section class="category-topics">
      <div class="section-label">ТЕМИ — {entries.length}</div>
      <ul class="topic-list topic-list-detailed">
        {entries.map((e) => (
          <li>
            <a class="topic-row" href={entryUrl(e)}>
              <span class="topic-code">{String(cat?.order ?? 0).padStart(2, '0')}.{String(e.data.order).padStart(2, '0')}</span>
              <span class="topic-popular" aria-label={e.data.popular ? 'Популярна тема' : undefined}>{e.data.popular ? '●' : ''}</span>
              <span class="topic-title">
                <strong>{e.data.title_uk}</strong>
                <em>{e.data.title_es}</em>
              </span>
              {e.data.cefr && <span class="level-badge">{e.data.cefr.toUpperCase()}</span>}
              <span class="topic-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>