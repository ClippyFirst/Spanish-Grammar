---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortedCategories, getCategory } from '../data/categories';
import { entryUrl, categoryUrl, withBase, parseId } from '../utils/content';

const entries = await getCollection('es');
const popular = entries.filter((e) => e.data.popular).sort((a, b) => a.data.order - b.data.order).slice(0, 5);
const featuredCategories = sortedCategories.slice(0, 9);
---
<BaseLayout
  title="Gramaticarrona — іспанська граматика для носіїв української"
  description="Швидкий і глибокий довідник з іспанської граматики для носіїв української: правила, формули, приклади, типові помилки, регіональні варіанти і пошук."
  canonical="/"
>
  <div class="container">
    <section class="hero">
      <h1>Іспанська граматика для українськомовних.</h1>
      <p class="lead">
        Редакційний довідник, який допомагає не просто запам’ятати правило, а зрозуміти його,
        зіставити форми та повернутися до потрібної конструкції в потрібний момент.
      </p>
      <div class="hero-meta" aria-label="Статистика довідника">
        <span>{entries.length} тем</span>
        <span>{sortedCategories.length} категорій</span>
        <span>UA · ES</span>
        <span>довідник, не курс</span>
      </div>
      <form class="search-bar" action={withBase('/search/')} method="get" role="search">
        <label class="visually-hidden" for="home-search">Пошук по граматиці</label>
        <input id="home-search" name="q" type="search" placeholder="presente, «подобається», ser / estar, subjuntivo…" autocomplete="off" />
        <button class="search-arrow" type="submit" aria-label="Перейти до пошуку">→</button>
      </form>
    </section>

    <section class="section learning-path" aria-label="Як користуватися довідником">
      <h2>Як читати довідник</h2>
      <div class="path-grid">
        <div><b>01</b><span>ЗНАЙТИ</span></div>
        <div><b>02</b><span>ЗРОЗУМІТИ</span></div>
        <div><b>03</b><span>ПОРІВНЯТИ</span></div>
        <div><b>04</b><span>ЗАПАМ’ЯТАТИ</span></div>
      </div>
    </section>

    <section class="section grammar-sections">
      <h2>Категорії — {sortedCategories.length}</h2>
      <ol class="category-list">
        {featuredCategories.map((c) => (
          <li>
            <a class="category-row" href={categoryUrl(c.key)}>
              <span class="category-index">{String(c.order).padStart(2, '0')}</span>
              <span class="category-copy">
                <strong>{c.titleUk}</strong>
                <em>{c.titleEs}</em>
                <span>{c.description}</span>
              </span>
              <span class="category-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="categories-more"><a href={withBase('/es/')}>і ще {sortedCategories.length - featuredCategories.length} категорій →</a></p>
    </section>

    <section class="section">
      <h2>Популярне</h2>
      <ul class="topic-list">
        {popular.map((e) => (
          <li>
            <a class="popular-row" href={entryUrl(e)}>
              <span class="topic-code">{String(getCategory(parseId(e.id).category)?.order ?? 0).padStart(2, '0')}.{String(e.data.order).padStart(2, '0')}</span>
              <span class="popular-dot" aria-hidden="true">●</span>
              <span class="popular-copy"><strong>{e.data.title_uk}</strong><em>{e.data.title_es}</em></span>
              {e.data.cefr && <span class="level-badge">{e.data.cefr.toUpperCase()}</span>}
              <span class="topic-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
