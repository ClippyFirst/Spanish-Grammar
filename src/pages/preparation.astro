      ['Присвійні займенники', 'pronouns/possessive-pronouns', 'НМТ · ЄВІ'],
      ['Вказівні займенники', 'pronouns/demonstrative-pronouns', 'НМТ · ЄВІ'],
      ['Неозначені ствердні займенники', 'pronouns/indefinite-pronouns', 'НМТ · ЄВІ'],
      ['Неозначені заперечні займенники', 'pronouns/indefinite-pronouns', 'НМТ · ЄВІ'],
      ['Зворотні займенники', 'pronouns/se-reflexive-impersonal-passive', 'НМТ · ЄВІ'],
      ['Відносні займенники', 'pronouns/relative-pronouns', 'НМТ · ЄВІ'],
