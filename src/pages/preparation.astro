---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/content';

const sections = [
  {
    number: '01',
    title: 'Іменник',
    es: 'Sustantivo',
    rows: [
      ['Рід іменників', 'nouns/genero', 'НМТ · ЄВІ'],
      ['Число іменників', 'nouns/numero-plural', 'НМТ · ЄВІ'],
      ['Складні іменники', 'word-formation/compounding', 'НМТ'],
      ['Множина складних іменників', 'word-formation/compounding', 'НМТ'],
      ['Іменники, що вживаються лише в множині', 'nouns/noun-special-cases', 'НМТ'],
      ['Зменшувальні суфікси — -ito, -ita та ін.', 'word-formation/diminutives', 'НМТ'],
    ],
  },
  {
    number: '02',
    title: 'Артикль',
    es: 'Artículo',
    rows: [
      ['Означений та неозначений артиклі', 'articles/definite-indefinite', 'НМТ · ЄВІ'],
      ['Відсутність артикля', 'articles/zero-article', 'НМТ'],
      ['Нейтральний артикль lo', 'articles/neutral-lo', 'НМТ · ЄВІ'],
    ],
  },
  {
    number: '03',
    title: 'Прикметник',
    es: 'Adjetivo',
    rows: [
      ['Рід і число прикметників', 'adjectives/adjective-agreement', 'НМТ · ЄВІ'],
      ['Узгодження прикметника з іменником', 'adjectives/adjective-agreement', 'НМТ · ЄВІ'],
      ['Ступені порівняння', 'adjectives/degrees-of-comparison', 'НМТ · ЄВІ'],
      ['bueno, malo, grande та усічені форми', 'adjectives/adjective-types-cultos', 'НМТ'],
      ['Вживання ser та estar з прикметниками', 'adjectives/adjective-complements', 'НМТ · ЄВІ'],
