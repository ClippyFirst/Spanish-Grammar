    ],
  },
  {
    number: '05',
    title: 'Числівник',
    es: 'Numeral',
    rows: [
      ['Кількісні числівники', 'fundamentals/numbers-in-speech', 'НМТ · ЄВІ'],
      ['Порядкові числівники', 'fundamentals/ordinal-numbers', 'НМТ · ЄВІ'],
    ],
  },
  {
    number: '06',
    title: 'Прислівник',
    es: 'Adverbio',
    rows: [
      ['Утворення прислівників із суфіксом -mente', 'adverbs/formation-and-position', 'НМТ · ЄВІ'],
      ['Ступені порівняння прислівників', 'adverbs/formation-and-position', 'НМТ · ЄВІ'],
      ['Прислівники способу дії', 'adverbs/types-frequency-time-manner', 'НМТ · ЄВІ'],
      ['Прислівники місця', 'adverbs/types-frequency-time-manner', 'НМТ · ЄВІ'],
      ['Прислівники часу', 'adverbs/types-frequency-time-manner', 'НМТ · ЄВІ'],
      ['Прислівники кількості', 'adverbs/muy-mucho-tan-tanto', 'НМТ'],
      ['Прислівники ствердження', 'adverbs/focus-and-stance', 'НМТ'],
      ['Прислівники заперечення', 'adverbs/focus-and-stance', 'НМТ'],
      ['Прислівники сумніву', 'adverbs/focus-and-stance', 'НМТ'],
      ['Модальні прислівники', 'adverbs/focus-and-stance', 'ЄВІ'],
      ['Прислівникові звороти', 'adverbs/types-frequency-time-manner', 'НМТ · ЄВІ'],
