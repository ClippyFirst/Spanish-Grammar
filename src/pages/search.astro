---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { entryUrl, parseId } from '../utils/content';
import { getCategory } from '../data/categories';
import { searchTopics, type SearchTopic } from '../utils/search';

const entries = await getCollection('es');
const catalog: SearchTopic[] = entries.map((entry) => {
  const { category, slug } = parseId(entry.id);
  const cat = getCategory(category);
  return {
    id: entry.id, slug, titleUk: entry.data.title_uk, titleEs: entry.data.title_es, titleEn: entry.data.title_en,
    summary: entry.data.short_description, keywords: entry.data.keywords, category,
    code: `${String(cat?.order ?? 0).padStart(2, '0')}.${String(entry.data.order).padStart(2, '0')}`,
    cefr: entry.data.cefr, popular: entry.data.popular, href: entryUrl(entry),
  };
});
const initialQuery = Astro.url.searchParams.get('q')?.trim() ?? '';
const initialHits = searchTopics(initialQuery, catalog, 30);
---
<BaseLayout title="Пошук по іспанській граматиці · Gramaticarrona" description="Пошук по всіх темах іспанської граматики. Шукайте українською, іспанською або англійською." canonical="/search/">
  <div class="container container-search">
    <header class="page-head">
      <div class="section-label">ПОШУК</div>
      <h1>Знайти тему</h1>
      <p class="synopsis">Шукайте українською, іспанською або англійською: <em>теперішній час</em>, <em>presente</em>, <em>subjuntivo</em> чи <em>«подобається»</em>.</p>
    </header>
    <div class="search-interface" id="search-interface">
      <form class="search-form" id="search-form" role="search" action={Astro.url.pathname} method="get">
        <label class="sr-only" for="search-input">Пошук по граматиці</label>
        <input id="search-input" type="search" name="q" value={initialQuery} placeholder="Пошук…" autocomplete="off" spellcheck="false" />
        <button type="submit">Пошук</button>
      </form>
      <p class="search-hint">Назва теми, граматичний термін, українське формулювання або ключове слово.</p>
      <p class="search-results-status" id="search-results-status" aria-live="polite"></p>
      <ol class="search-results" id="search-results">
        {initialHits.map(({ topic }) => (
          <li class="search-result"><a class="search-result-link" href={topic.href}>
            <span class="search-result-code">{topic.code}</span>
            <span class="search-result-copy"><strong>{topic.titleUk}</strong><em>{topic.titleEs}</em><small>{topic.summary}</small></span>
            <span class="search-result-meta">{topic.popular && <span class="search-result-popular">● популярне</span>}{topic.cefr && <span class="level-badge">{topic.cefr.toUpperCase()}</span>}</span>
            <span class="search-result-arrow" aria-hidden="true">→</span>
          </a></li>
        ))}
      </ol>
    </div>
  </div>
</BaseLayout>
<script is:inline define:vars={{ catalog }}>
  const topics = catalog;
  function fold(value) { return String(value).toLocaleLowerCase('uk').normalize('NFD').replace(/\p{M}/gu, '').replace(/[-’'`]/g, ' ').replace(/\s+/g, ' ').trim(); }
  function tokens(value) { return fold(value).split(' ').filter((token) => token.length > 0); }
  function searchTopics(query, limit) {
    const q=fold(query); if(!q)return []; const qTokens=tokens(query); const hits=[];
    topics.forEach((topic)=>{
      const fields=[fold(topic.titleUk),fold(topic.titleEs),fold(topic.titleEn)]; const id=fold(topic.id); const slug=fold(topic.slug); const summary=fold(topic.summary); const aliases=topic.keywords.map(fold); let score=0;
      if(fields.some((x)=>x===q)||id===q)score=100;
      else if(fields.some((x)=>x.startsWith(q)))score=88;
      else if(aliases.some((x)=>x===q||x.startsWith(q)))score=84;
      else if(fields.some((x)=>x.includes(q)))score=76;
      else if(aliases.some((x)=>x.includes(q)))score=64;
      else if(id.includes(q)||slug.includes(q))score=60;
      else if(summary.includes(q))score=48;
      else { const blob=[...fields,id,slug,summary,...aliases].join(' '); const matched=qTokens.filter((t)=>t.length>1&&blob.includes(t)).length; if(!matched)return; score=30+matched*8; }
      if(topic.popular)score+=2; hits.push({topic,score});
    });
    hits.sort((a,b)=>b.score-a.score||a.topic.titleUk.localeCompare(b.topic.titleUk,'uk')); return hits.slice(0,limit);
  }
  function esc(value) { return String(value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); }
  function render(query, updateUrl) {
    const input=document.getElementById('search-input'), results=document.getElementById('search-results'), status=document.getElementById('search-results-status'); if(!input||!results||!status)return; const clean=query.trim();
    if(updateUrl){const url=new URL(window.location.href); if(clean)url.searchParams.set('q',clean); else url.searchParams.delete('q'); window.history.replaceState({},'',url);}
    if(!clean){results.innerHTML='';status.textContent='Введіть слово або фразу для пошуку.';return;}
    const hits=searchTopics(clean,30); status.textContent=hits.length?`ЗНАЙДЕНО — ${hits.length}`:`НІЧОГО НЕ ЗНАЙДЕНО ДЛЯ «${clean}»`;
    results.innerHTML=hits.map(({topic})=>`<li class="search-result"><a class="search-result-link" href="${esc(topic.href)}"><span class="search-result-code">${esc(topic.code)}</span><span class="search-result-copy"><strong>${esc(topic.titleUk)}</strong><em>${esc(topic.titleEs)}</em><small>${esc(topic.summary)}</small></span><span class="search-result-meta">${topic.popular?'<span class="search-result-popular">● популярне</span>':''}${topic.cefr?'<span class="level-badge">'+esc(topic.cefr.toUpperCase())+'</span>':''}</span><span class="search-result-arrow" aria-hidden="true">→</span></a></li>`).join('');
  }
  const form=document.getElementById('search-form'), input=document.getElementById('search-input');
  if(form&&input){form.addEventListener('submit',(event)=>{event.preventDefault();render(input.value,true);}); input.addEventListener('input',()=>render(input.value,true));}
  if(input.value)render(input.value,false); else document.getElementById('search-results-status').textContent='Введіть слово або фразу для пошуку.';
</script>