---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Пошук по іспанській граматиці · GrammarWay ES"
  description="Пошук по всіх темах іспанської граматики. Шукайте українською, іспанською або англійською — present indikatyw, «теперішній час», subjunctive, ser/estar."
  canonical="/search/"
>
  <div class="container container-search">
    <header class="page-head">
      <h1>Пошук</h1>
      <p class="synopsis">
        Знайдіть тему українською, іспанською або англійською:
        <em>теперішній час</em>, <em>presente</em>, <em>subjunctive</em> чи <em>«подобається»</em>.
      </p>
    </header>

    <div class="search-interface" id="search-interface">
      <form class="search-form" id="search-form" role="search">
        <label class="sr-only" for="search-input">Пошук по граматиці</label>
        <input id="search-input" type="search" name="q" placeholder="Пошук…" autocomplete="off" />
        <button type="submit">Пошук</button>
      </form>
      <p class="search-results-status" id="search-results-status" aria-live="polite"></p>
      <ol class="search-results" id="search-results"></ol>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ base: import.meta.env.BASE_URL ?? '/' }}>
  // Use Pagefind's core Search API. This avoids pagefind-ui.js path detection
  // and lets the site's own design system control the search interface.
  async function initSearch() {
    var prefix = (typeof base === 'string' ? base : '/').replace(/\/$/, '');
    var input = document.getElementById('search-input');
    var form = document.getElementById('search-form');
    var resultsEl = document.getElementById('search-results');
    var statusEl = document.getElementById('search-results-status');
    if (!input || !form || !resultsEl || !statusEl) return;

    try {
      var pagefind = await import(prefix + '/pagefind/pagefind.js');
      await pagefind.options({
        baseUrl: prefix + '/',
        bundlePath: prefix + '/pagefind/'
      });

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      async function runSearch(query, updateUrl) {
        var clean = query.trim();
        resultsEl.innerHTML = '';

        if (updateUrl) {
          var next = new URL(window.location.href);
          if (clean) next.searchParams.set('q', clean);
          else next.searchParams.delete('q');
          window.history.replaceState({}, '', next);
        }

        if (!clean) {
          statusEl.textContent = 'Введіть слово або фразу для пошуку.';
          return;
        }

        statusEl.textContent = 'Шукаємо…';
        var search = await pagefind.search(clean);

        if (!search.results.length) {
          statusEl.textContent = 'Нічого не знайдено для «' + clean + '».';
          return;
        }

        statusEl.textContent = 'Знайдено: ' + search.results.length + '.';

        var items = await Promise.all(
          search.results.slice(0, 30).map(async function(result) {
            return await result.data();
          })
        );

        items.forEach(function(data) {
          var li = document.createElement('li');
          li.className = 'search-result';
          var title = data.meta && data.meta.title ? data.meta.title : 'Без назви';
          var excerpt = data.excerpt || '';
          var url = data.url || '#';

          li.innerHTML =
            '<a class="search-result-link" href="' + escapeHtml(url) + '">' +
              '<strong>' + escapeHtml(title) + '</strong>' +
              (excerpt ? '<span>' + excerpt + '</span>' : '') +
            '</a>';

          resultsEl.appendChild(li);
        });
      }

      form.addEventListener('submit', function(event) {
        event.preventDefault();
        runSearch(input.value, true);
      });

      var initial = new URL(window.location.href).searchParams.get('q') || '';
      input.value = initial;

      if (initial) {
        await runSearch(initial, false);
      } else {
        statusEl.textContent = 'Введіть слово або фразу для пошуку.';
      }
    } catch (e) {
      statusEl.textContent =
        'Пошук не зміг завантажити Pagefind. Перевірте, що після npm run build існує dist/pagefind/pagefind.js, і запустіть сайт через npm run preview.';
      console.error('Pagefind initialization failed:', e);
    }
  }

  window.addEventListener('DOMContentLoaded', initSearch);
</script>
